+def get_compile_command(defines: list[str], tmpdir: str, uniquename: str, sources : list[str], instrumenter : str) -> list[str]:
+  """
+  Get the compilation command for Juliet test suites.
+  `defines` are lists like ["OMITGOOD"] or ["OMITBAD"].
+  `tmpdir` is a path where we can create temporary files.
+  `uniquename` is a long string usable as file name prefix.
+  """
+  define_str = ' '.join(["-D" + s for s in defines])
+  bitcode_raw = f"{uniquename}_raw.bc"
+  ir_raw = f"{uniquename}_raw.ll"
+
+  # first, produce a single bitcode file
+  bitcode_gen = []
+  if len(sources) == 1:
+    tmpname = f"{uniquename}_tmp.bc"
+    bitcode_gen.append(f"$(CLANG) -O1 $(CLANG_COMPILE_FLAGS) $(INSTRUMENTER_GLOBAL_CFLAGS) {define_str} -c -emit-llvm $< -o {tmpname}")
+    bitcode_gen.append(f"$(LLVM_LINK) {tmpname} {supportlib_bitcode_path} -o {bitcode_raw}")
+  else:
+    # compile each source file to bitcode and then merge them
+    bitcode_list = []
+    for index, src in enumerate(sources):
+      tmpname = uniquename + f"_tmp{index}.bc"
+      bitcode_list.append(tmpname)
+      bitcode_gen.append(f"$(CLANG) -O1 $(CLANG_COMPILE_FLAGS) $(INSTRUMENTER_GLOBAL_CFLAGS) {define_str} -c -emit-llvm {src} -o {tmpname}")
+    bitcode_list.append(supportlib_bitcode_path)  # add support library bitcode
+    bitcode_gen.append(f"$(LLVM_LINK) -o {bitcode_raw} {' '.join(bitcode_list)}")
+  bitcode_gen.append(f"$(LLVM_DIS) {bitcode_raw} -o {ir_raw}")
+
+  if instrumenter == "psan":
+    ir_instrumented = f"{uniquename}_psan.ll"
+    return bitcode_gen + [
+      f"$(PSAN) $(PSAN_FLAGS) {bitcode_raw} -o {ir_instrumented}",
+      f"$(CLANG) -O1  {ir_instrumented} $(CLANG_LINK_FLAGS) -o $@",
+    ]
+  elif instrumenter == "asan":
+    return bitcode_gen + [
+      f"$(CLANG) -O1  {bitcode_raw} $(CLANG_LINK_FLAGS) -fsanitize=address -o $@",
+    ]
+  elif instrumenter == "softboundcets":
+    ir_instrumented = f"{uniquename}_softboundcets.ll"
+    return bitcode_gen + [
+      f"$(SOFTBOUNDCETS) {softboundcets_flags} {ir_raw} -o {ir_instrumented}",
+      f"$(CLANG) -O1  {ir_instrumented} $(CLANG_LINK_FLAGS) -o $@",
+    ]
+  else:
+    raise RuntimeError(f"Unexpected instrumenter: {instrumenter}")
+
+def collect_testcases() -> dict[str, list[str | tuple[str, list[str]]]]:
+  out = {} # category -> list of test cases
+  # each test case could be a string or a tuple of (test case base name, suffixes)
+  # some test cases have code split among multiple files; we need to group them together
+  exclusion_stats = {} # category -> <total test case counts, number of excluded test cases>
+  for cwe in accepted_category_list:
+    cwe_dir = os.path.join(juliet_root_dir, cwe)
+    if not os.path.isdir(cwe_dir):
+      # Skip if directory for this CWE doesn't exist
+      continue
+
+    out[cwe] = []
+    category_total = 0
+    category_excluded_dict = {}
+    # Look for subdirectories like "s01", "s02", etc.
+    subdir_list = sorted(os.listdir(cwe_dir))
+    subdir_list.append("") # add test cases that are not in subdirectories
+    for sdir in subdir_list:
+      subdir_path = os.path.join(cwe_dir, sdir) if len(sdir) > 0 else cwe_dir
+      if not os.path.isdir(subdir_path):
+        continue
+
+      # Now, collect all .c files in subdir_path
+      valid_fnames = []
+      for fname in sorted(os.listdir(subdir_path)):
+        if not fname.endswith(".c"):
+          continue
+
+        basename = fname[:-2]  # remove .c
+        valid_fnames.append(basename)
+
+      valid_fnames.sort()
+      last_group_base = None
+      last_group_suffixes = []
+
+      cur_record = []
+
+      def end_group():
+        nonlocal last_group_base, last_group_suffixes
+        if last_group_base:
+          cur_record.append((last_group_base, last_group_suffixes))
+          last_group_base = None
+          last_group_suffixes = []
+
+      for fname in valid_fnames:
+        # first, see if this file is part of a group
+        # we expect standalone test cases to end file names with numbers (e.g., ..._01)
+        # if the file has group, it should have a character suffix like _01a, _01b, etc.
+        parts = fname.split("_")
+        if len(parts) < 2:
+          # standalone test case
+          end_group()
+          cur_record.append(fname)
+          continue
+
+        tail = parts[-1]
+        if tail.isdigit():
+          # standalone test case
+          end_group()
+          cur_record.append(fname)
+          continue
+
+        # sanity check
+        if not tail[:-1].isdigit():
+          raise ValueError(f"Unexpected suffix: {tail}")
+        # extract the group and character suffix
+        group_base = fname[:-1]
+        char = tail[-1]
+        if group_base == last_group_base:
+          last_group_suffixes.append(char)
+          continue
+
+        end_group()
+        last_group_base = group_base
+        last_group_suffixes = [char]
+      end_group()
+
+      record_exclusion_reason = [ExcludeReason.INCLUDED] * len(cur_record)
+
+      for index, record in enumerate(cur_record):
+        group_base : str = record[0] if isinstance(record, tuple) else record
+        for reason, exclude_list in general_exclude_dict.items():
+          if any(excl in group_base for excl in exclude_list):
+            if record_exclusion_reason[index] == ExcludeReason.INCLUDED:
+              record_exclusion_reason[index] = reason
+
+      # Check additional_excludes
+      if cwe in additional_excludes and sdir in additional_excludes[cwe]:
+        patterns = additional_excludes[cwe][sdir]
+        for reason, patterns in patterns.items():
+          for pat in patterns:
+            num_excluded = 0
+            if isinstance(pat, str):
+              for index, record in enumerate(cur_record):
+                group_base : str = record[0] if isinstance(record, tuple) else record
+                if group_base.startswith(pat):
+                  if record_exclusion_reason[index] == ExcludeReason.INCLUDED:
+                    record_exclusion_reason[index] = reason
+                  num_excluded += 1
+            elif isinstance(pat, tuple):
+              prefix, range_from, range_to = pat
+              for index, record in enumerate(cur_record):
+                group_base : str = record[0] if isinstance(record, tuple) else record
+                if not group_base.startswith(prefix):
+                  continue
+                parts = group_base.split("_")
+                if len(parts) < 2:
+                  raise RuntimeError(f"Unexpected base name: {group_base}")
+                suffix = parts[-1]
+                if not suffix.isdigit():
+                  raise RuntimeError(f"Unexpected suffix: {suffix}")
+                suffix_index = int(suffix)
+                if suffix_index >= range_from and suffix_index <= range_to:
+                  if record_exclusion_reason[index] == ExcludeReason.INCLUDED:
+                    record_exclusion_reason[index] = reason
+                  num_excluded += 1
+            else:
+              raise ValueError(f"Unexpected pattern: {pat}")
+            if num_excluded == 0:
+              raise RuntimeError(f"Pattern not applied to any test case: {cwe}/{sdir}: {str(pat)}")
+
+      category_total += len(cur_record)
+      for index, record in enumerate(cur_record):
+        reason = record_exclusion_reason[index]
+        match reason:
+          case ExcludeReason.INCLUDED:
+            sdir_prefix = sdir + "_" if len(sdir) > 0 else ""
+            if isinstance(record, tuple):
+              group_base, group_suffixes = record
+              out[cwe].append((sdir_prefix + group_base, group_suffixes))
+            elif isinstance(record, str):
+              out[cwe].append(sdir_prefix + record)
+            else:
+              raise ValueError(f"Unexpected record: {record}")
+          case _:
+            if reason in category_excluded_dict:
+              category_excluded_dict[reason] += 1
+            else:
+              category_excluded_dict[reason] = 1
+
+    exclusion_stats[cwe] = (category_total, category_excluded_dict)
+  print("Exclusion stats:")
+  exclude_reasons = ExcludeReason.get_exclude_reasons_ordered()
+  print("Category,Total," + ",".join([x.name for x in exclude_reasons]))
+  for cwe, (total, excluded) in exclusion_stats.items():
+    print(f"{cwe},{total}," + ",".join([str(excluded.get(x, 0)) for x in exclude_reasons]))
+  return out
+
+def write_makefile(instrumenter : str):
+  testcases = collect_testcases()
+
+  # Write out a JSON manifest so it's easier to see what was collected
+  with open('manifest.json', 'w', encoding='utf-8') as f:
+    json.dump(testcases, f, ensure_ascii=False, indent=2)
+
+  if instrumenter in global_cflags_dict:
+    makefile_vars["INSTRUMENTER_GLOBAL_CFLAGS"] = global_cflags_dict[instrumenter]
+
+  lines = []
+  lines.append(".PHONY: all clean\n")
+  # variables
+  for k, v in makefile_vars.items():
+    lines.append(f"{k} := {v}")
+  lines.append("")
+
+  all_rule_index = len(lines)  # we'll insert "all:" at this index
+
+  # We'll keep track of all build targets to generate an "all:" rule
+  all_targets = []
+
+  # Write additional targets. They are NOT part of the "all:" rule.
+  for target, cmds in additional_targets.items():
+    lines.append(f"{target}:")
+    assert isinstance(cmds, list)
+    for c in cmds:
+      lines.append('\t' + c)
+    lines.append("")
+
+  for cwe, test_list in testcases.items():
+    # Example cwe: "CWE122_Heap_Based_Buffer_Overflow"
+    # test_list might have things like: ["s01_CWE122_Heap_Based_Buffer_Overflow__foo_01", ...]
+
+    for test_entry in test_list:
+      test_name = test_entry
+      group_suffix_list = None
+      if isinstance(test_entry, (tuple, list)) and len(test_entry) == 2:
+        test_name, group_suffix_list = test_entry
+      elif not isinstance(test_entry, str):
+        raise ValueError(f"Unexpected test entry: {test_entry}")
+      # Separate out sdir vs. the rest of the base filename
+      # sdir may be empty
+      # test_name = "s01_CWE122_Heap_Based_Buffer_Overflow__foo_01"
+      sdir = ""
+      basefilename = test_name
+      if test_name.startswith("s"):
+        parts = test_name.split("_", 1)
+        if len(parts) != 2:
+          # Defensive check; skip malformed
+          continue
+        sdir, basefilename = parts
+      # Original C file lives at:
+      #   testcases/cwe/sdir/basefilename.c
+      sources = []
+      if group_suffix_list:
+        for suffix in group_suffix_list:
+          sources.append(os.path.join(juliet_root_dir, cwe, sdir, basefilename + suffix + ".c"))
+      else:
+        sources.append(os.path.join(juliet_root_dir, cwe, sdir, basefilename + ".c"))
+      source_file_str = " ".join(sources)
+
+      # Good version
+      target_good = os.path.join(output_dir, cwe, test_name + "_good")
+      defines_good = ["INCLUDEMAIN", "OMITBAD"]  # Juliet convention for building the "good" path
+      cmds_good = get_compile_command(defines_good, output_dir, target_good, sources, instrumenter)
+
+      # Bad version
+      target_bad = os.path.join(output_dir, cwe, test_name + "_bad")
+      defines_bad = ["INCLUDEMAIN", "OMITGOOD"]  # Juliet convention for building the "bad" path
+      cmds_bad = get_compile_command(defines_bad, output_dir, target_bad, sources, instrumenter)
+
+      # Append to our "all_targets" so we can do "make all"
+      all_targets.append(target_good)
+      all_targets.append(target_bad)
+
+      # We will create rules for each target. For example:
+      #
+      # outputdir/CWE122_Heap_Based_Buffer_Overflow/s01_CWE122_Heap_Based_Buffer_Overflow__foo_01_good: testcases/CWE122_Heap_Based_Buffer_Overflow/s01/CWE122_Heap_Based_Buffer_Overflow__foo_01.c
+      #   mkdir -p $(dir $@)
+      #   clang ...
+      #   psan ...
+      #   clang ...
+      #
+
+      # Good target rule
+      lines.append(f"{target_good}: {source_file_str} $(COMMON_DEPS)")
+      lines.append(f"\tmkdir -p $(dir $@)")
+      for c in cmds_good:
+        lines.append(f"\t{c}")
+      lines.append("")  # blank line for readability
+
+      # Bad target rule
+      lines.append(f"{target_bad}: {source_file_str} $(COMMON_DEPS)")
+      lines.append(f"\tmkdir -p $(dir $@)")
+      for c in cmds_bad:
+        lines.append(f"\t{c}")
+      lines.append("")
+
+  # Add "all" rule at the top
+  all_rules_str = " \\\n\t".join(all_targets)
+  lines.insert(all_rule_index, f"all: {all_rules_str}\n")
+
+  # Add a clean rule
+  lines.append("clean:")
+  lines.append(f"\trm -rf {output_dir}")
+  lines.append("")
+
+  # Finally, write it out as Makefile
+  makefile_name = f"Makefile_{instrumenter}"
+  with open(makefile_name, "w", encoding="utf-8") as mf:
+    mf.write("\n".join(lines))
+
+  print(f"Output written to {makefile_name}. Run 'make -f {makefile_name}' to build.")
+
+class TestCaseResult(enum.Enum):
+  PASS_GOOD = enum.auto() # good test case finishes without error
+  PASS_BAD = enum.auto() # bad test case finishes with error being correctly detected
+  UNEXPECTED_CRASH = enum.auto() # test case crashes unexpectedly (exitcode != 0)
+  UNEXPECTED_FINISH = enum.auto() # test case finishes without error, but it should have failed
+  TIMEOUT = enum.auto() # test case times out
+
+@dataclasses.dataclass
+class CategorySummaryData:
+  name : str
+  numtests : int
+  numfailed_good : int
+  numfailed_bad : int
+
+report_file = "psan_juliet.xlsx"
+
+def write_test_report(results : dict[str, dict[str, tuple[TestCaseResult, str, TestCaseResult, str]]], summary : list[CategorySummaryData]):
+  workbook = xlsxwriter.Workbook(report_file)
+  # summary page first
+  sheet = workbook.add_worksheet("Summary")
+  sheet.write(0, 0, "Category")
+  sheet.write(0, 1, "NumTests")
+  sheet.write(0, 2, "Good Failed")
+  sheet.write(0, 3, "Bad Failed")
+  sheet.set_column(0, 0, 40)
+  for row, summary_data in enumerate(summary, 1):
+    sheet.write(row, 0, summary_data.name)
+    sheet.write(row, 1, summary_data.numtests)
+    sheet.write(row, 2, summary_data.numfailed_good)
+    sheet.write(row, 3, summary_data.numfailed_bad)
+  # then individual test cases
+  for category, category_data in results.items():
+    sheetname = category if len(category) < 32 else category[:31]
+    sheet = workbook.add_worksheet(sheetname)
+    # write header
+    sheet.write(0, 0, "Name")
+    sheet.write(0, 1, "GoodVer")
+    sheet.write(0, 2, "Output")
+    sheet.write(0, 3, "BadVer")
+    sheet.write(0, 4, "Output")
+    # widen columns 0, 2, 4
+    sheet.set_column(0, 0, 80)
+    sheet.set_column(2, 2, 40)
+    sheet.set_column(4, 4, 40)
+    row = 1
+    for test_name, test_data in category_data.items():
+      good_result, good_output, bad_result, bad_output = test_data
+      sheet.write(row, 0, test_name)
+      sheet.write(row, 1, good_result.name)
+      if good_result != TestCaseResult.PASS_GOOD:
+        sheet.write(row, 2, good_output)
+      sheet.write(row, 3, bad_result.name)
+      if bad_result != TestCaseResult.PASS_BAD:
+        sheet.write(row, 4, bad_output)
+      row += 1
+  workbook.close()
+
+default_env = {
+  # because many test cases call globalReturnsTrueOrFalse() and put buggy version in the true branch,
+  # we set the default value here so that the calls return true
+  "PSAN_ENV_GLOBAL_RETURNS_TRUE_OR_FALSE": "11",
+}
+psan_juliet_stdin = {}
+def get_testcase_input(category: str, test_name: str) -> tuple[str | None, dict[str, str] | None, tuple[bool, str] | None]:
+  network_data = None
+  if category in psan_juliet_stdin:
+    ruleset_dict = psan_juliet_stdin[category]
+    # split the test name into the base name and the numeric suffix
+    parts = test_name.rsplit("_", 1)
+    if len(parts) != 2:
+      raise ValueError(f"Unexpected test name: {test_name}")
+    base_name, suffix = parts
+    index = int(suffix)
+    if base_name in ruleset_dict:
+      ruleset = ruleset_dict[base_name]
+      for rule in ruleset:
+        if range_from := rule.get("range_from"):
+          if index < range_from:
+            continue
+        if range_to := rule.get("range_to"):
+          if index > range_to:
+            continue
+        env = rule.get("env", default_env)
+        if randlist := rule.get("rand", None):
+          env = env.copy()
+          env["PSAN_ENV_RAND_COUNT"] = str(len(randlist))
+          for i, value in enumerate(randlist):
+            env[f"PSAN_ENV_RAND_{i}"] = str(value)
+        if len(env) == 0:
+          env = None
+        if network_info := rule.get("network", None):
+          is_server = network_info.get("server", False)
+          data = network_info.get("data", "")
+          if len(data) == 0:
+            raise ValueError(f"Empty network data: {category}/{test_name}")
+          network_data = (is_server, data)
+        return rule.get("data", None), env, network_data
+  return None, default_env, network_data
+
+network_lock = threading.Lock()
+JULIET_PORT = 27015
+JULIET_HOST = "127.0.0.1"
+def reset_socket():
+  try:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server_socket:
+      server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+      server_socket.settimeout(3)
+      server_socket.bind((JULIET_HOST, JULIET_PORT))
+      server_socket.listen(1)
+      server_socket.close()
+  except:
+    pass
+  try:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as client_socket:
+      client_socket.connect((JULIET_HOST, JULIET_PORT))
+      client_socket.sendall(b"")
+      client_socket.close()
+  except:
+    pass
+def run_testcase(category: str, test_name: str, good_path : str, bad_path : str, data_stdin : str | None, data_env : dict[str, str] | None, data_network : tuple[bool, str] | None) -> tuple[TestCaseResult, str, TestCaseResult, str]:
+  # get a temporary file path for stdout/stderr passing
+  # for some reason, direct pipe for stdout/stderr does not work
+  with tempfile.NamedTemporaryFile(delete=False, prefix=f"{category}_{test_name}") as tmp_file:
+    tmp_name = tmp_file.name
+  def execute_program(path : str, data_stdin : str | None, data_env : dict[str, str] | None, tmp_name : str) -> tuple[int, str]:
+    isTimeout = False
+    exit_code = -1
+    network_log = None
+    with open(tmp_name, 'wb') as outfile:
+      def launch_proc():
+        return subprocess.Popen([path], stdin=subprocess.PIPE, stdout=outfile, stderr=outfile, env=data_env, shell=True, text=True)
+      if data_network is not None:
+        network_lock.acquire()
+      if data_network is None:
+        # we can launch processes immediately
+        proc = launch_proc()
+      else:
+        # we may need to do more setup for network before launching the process
+        is_server, data = data_network
+        reset_socket()
+        if is_server:
+          # Act as the server
+          with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server_socket:
+            server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            server_socket.settimeout(3)
+            server_socket.bind((JULIET_HOST, JULIET_PORT))
+            server_socket.listen(1)
+            proc = launch_proc()
+            try:
+              conn, addr = server_socket.accept()
+              with conn:
+                conn.sendall(data.encode('utf-8'))
+            except socket.timeout:
+              network_log = "Timeout: Server"
+            server_socket.close()
+        else:
+          # Act as the client
+          proc = launch_proc()
+          retry = 5
+          while retry > 0:
+            time.sleep(0.2)
+            try:
+              with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as client_socket:
+                client_socket.connect((JULIET_HOST, JULIET_PORT))
+                client_socket.sendall(data.encode('utf-8'))
+                client_socket.close()
+              # because some good test cases are doing multiple bind-listen-accept, here we don't break
+              # break
+            except ConnectionRefusedError:
+              pass
+            retry -= 1
+          if retry == 0:
+            network_log = "Timeout: Client"
+      try:
+        timeout = 3 if data_network is None else 10
+        proc.communicate(data_stdin, timeout=timeout)
+      except subprocess.TimeoutExpired:
+        proc.kill()
+        isTimeout = True
+      exit_code = proc.returncode
+      if data_network is not None:
+        network_lock.release()
+    with open(tmp_name, 'r', encoding='utf-8', errors='backslashreplace') as f:
+      output = f.read()
+    if isTimeout:
+      output = "Timeout: " + output
+    if network_log is not None:
+      output = '[' + network_log + ']\n' + output
+    return exit_code, output
+
+  if data_env is not None:
+    new_env = os.environ.copy()
+    new_env.update(data_env)
+    data_env = new_env
+
+  exitcode_good, output_good = execute_program(good_path, data_stdin, data_env, tmp_name)
+  if exitcode_good != 0:
+    if output_good.startswith("Timeout"):
+      good_result = TestCaseResult.TIMEOUT
+    else:
+      good_result = TestCaseResult.UNEXPECTED_CRASH
+  elif "Finished good" in output_good:
+    good_result = TestCaseResult.PASS_GOOD
+  else:
+    good_result = TestCaseResult.UNEXPECTED_FINISH
+  exitcode_bad, output_bad = execute_program(bad_path, data_stdin, data_env, tmp_name)
+  if exitcode_bad != 0:
+    # for simplicity, we detect all target's error reporting pattern here
+    if "PSAN: " in output_bad:
+      bad_result = TestCaseResult.PASS_BAD
+    elif "ERROR: AddressSanitizer:" in output_bad:
+      bad_result = TestCaseResult.PASS_BAD
+    elif "Softboundcets:" in output_bad:
+      bad_result = TestCaseResult.PASS_BAD
+    elif output_bad.startswith("Timeout"):
+      bad_result = TestCaseResult.TIMEOUT
+    else:
+      bad_result = TestCaseResult.UNEXPECTED_CRASH
+      #print(f"Unexpected crash: {output_bad}")
+  else:
+    bad_result = TestCaseResult.UNEXPECTED_FINISH
+  os.unlink(tmp_name)
+  return good_result, output_good, bad_result, output_bad
+
+RUN_DEBUG = False
+def run_test(run_network_only : bool = False, run_local_only : bool = False, test_filters : list[str] | None = None):
+  if not os.getenv("PSAN_NO_COREDUMP"):
+    raise RuntimeError("PSAN_NO_COREDUMP is not set. Please make sure the coredump generation is disabled (e.g., source ./sourceme.sh).")
+  start_time = time.time()
+  def printstatus(s : str):
+    print(f"[{time.time() - start_time:.2f}] {s}")
+
+  global psan_juliet_stdin
+  with open("psan_juliet_stdin.yml", "r", encoding="utf-8") as f:
+    psan_juliet_stdin = yaml.safe_load(f)
+  print(psan_juliet_stdin)
+  with open('manifest.json', 'r', encoding='utf-8') as f:
+    testcases = json.load(f)
+  printstatus("manifest.json loaded")
+
+  results = {}
+  summary_page_data : list[CategorySummaryData] = []
+  max_workers = os.cpu_count()
+  if run_network_only:
+    # we use a lock anyway
+    max_workers = 1
+  with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
+    futures = {}
+    num_tests = 0
+    # launch tests
+    for category, manifest in testcases.items():
+      category_file_path = os.path.join(output_dir, category)
+      category_futures = {}
+      for test in manifest:
+        test_basename = ''
+        if isinstance(test, str):
+          test_basename = test
+        else:
+          test_basename = test[0]
+        if test_filters is not None and not any(test_basename.startswith(f) for f in test_filters):
+          #printstatus(f"Skipping {category}/{test_basename} due to filter")
+          continue
+        good_path = os.path.join(category_file_path, test_basename + "_good")
+        bad_path = os.path.join(category_file_path, test_basename + "_bad")
+        if not os.path.exists(good_path):
+          raise RuntimeError(f"Error: {good_path} does not exist.")
+        if not os.path.exists(bad_path):
+          raise RuntimeError(f"Error: {bad_path} does not exist.")
+        data_stdin, data_env, data_network = get_testcase_input(category, test_basename)
+        if data_network is None:
+          if run_network_only:
+            continue
+        else:
+          if run_local_only:
+            continue
+        future_obj = executor.submit(run_testcase, category, test_basename, good_path, bad_path, data_stdin, data_env, data_network)
+        category_futures[test_basename] = future_obj
+        num_tests += 1
+        # for testing, we just launch limited number of tests
+        if RUN_DEBUG:
+          if num_tests == 40:
+            break
+      futures[category] = category_futures
+      # for testing, we just launch one category
+      if RUN_DEBUG:
+        break
+
+    # collect results
+    printstatus(f"Running {num_tests} test cases...")
+    num_completed = 0
+    for category, category_futures in futures.items():
+      category_results = {}
+      printstatus("Category: " + category)
+      numfailed_good = 0
+      numfailed_bad = 0
+      for test_name, future in category_futures.items():
+        result = future.result()
+        category_results[test_name] = result
+        num_completed += 1
+        printstatus(f"[{num_completed}/{num_tests}] {test_name} {result[0].name} {result[2].name}")
+        if result[0] != TestCaseResult.PASS_GOOD:
+          numfailed_good += 1
+          print(result[1])
+        if result[2] != TestCaseResult.PASS_BAD:
+          numfailed_bad += 1
+          print(result[3])
+      results[category] = category_results
+      summary = CategorySummaryData(name=category, numtests=len(category_futures), numfailed_good=numfailed_good, numfailed_bad=numfailed_bad)
+      summary_page_data.append(summary)
+  printstatus("Writing report file: " + report_file)
+  write_test_report(results, summary_page_data)
+  printstatus("Done")
+
+def main():
+  parser = argparse.ArgumentParser(description="Run Juliet test suite with PSAN")
+  parser.add_argument("-m", action="store_true", help="Generate Makefile for Juliet test suite")
+  parser.add_argument("--instrumenter", type=str, default="psan", help="Instrumentation tool target")
+  parser.add_argument("-r", action="store_true", help="Run Juliet test suite with PSAN")
+  parser.add_argument("--run-networkonly", action="store_true", help="Run network-only tests")
+  parser.add_argument("--run-localonly", action="store_true", help="Run local-only tests")
+  parser.add_argument("--test-filters", type=str, nargs='*', default=None, help="Filter test cases by prefix (e.g., CWE122_Heap_Based_Buffer_Overflow)")
+  parser.add_argument("--count-testcases", type=str, help="Count number of test cases")
+  args = parser.parse_args()
+  if args.run_localonly and args.run_networkonly:
+    raise ValueError("Cannot specify both --run-localonly and --run-networkonly")
+  if args.m:
+    write_makefile(instrumenter=args.instrumenter)
+  elif args.r:
+    test_filters = args.test_filters if args.test_filters is not None and len(args.test_filters) > 0 else None
+    run_test(args.run_networkonly, args.run_localonly, test_filters)
+  elif args.count_testcases:
+    global accepted_category_list
+    global additional_excludes
+    accepted_category_list = args.count_testcases.split(",")
+    additional_excludes.clear()  # clear any previous excludes
+    if len(accepted_category_list) == 0:
+      raise ValueError("No test cases specified for counting. Use --count-testcases with a comma-separated list of categories.")
+    if not all(cwe.startswith("CWE") for cwe in accepted_category_list):
+      raise ValueError("All test cases must start with 'CWE'. Please check the --count-testcases argument.")
+    testcases = collect_testcases()
+    total_count = 0
+    for cwe, tests in testcases.items():
+      total_count += count
+    print(f"Total: {total_count} test cases")
+
+if __name__ == "__main__":
+  # write_makefile()
+  main()
