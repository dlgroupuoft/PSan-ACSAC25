+#define PSAN_RAND_SIZE_MAX 64
+uint64_t PSAN_RAND_POOL[PSAN_RAND_SIZE_MAX] = {0};
+
+static int psanGetRand(uint64_t* v) {
+    // for random values, they will be populated from the environment variables according to the following rules:
+    // 1. number of specified values are stored in PSAN_ENV_RAND_COUNT
+    // 2. each value is stored in PSAN_ENV_RAND_0, PSAN_ENV_RAND_1, ..., PSAN_ENV_RAND_N
+    static unsigned randCount = 0;
+    static int initialized = 0;
+    static unsigned consumed = 0;
+    if (!initialized) {
+        char* PSAN_ENV_RAND_COUNT = getenv("PSAN_ENV_RAND_COUNT");
+        if (PSAN_ENV_RAND_COUNT) {
+            randCount = atoi(PSAN_ENV_RAND_COUNT);
+            if (randCount > PSAN_RAND_SIZE_MAX) {
+                printf("PSAN_ENV_RAND_COUNT is too large\n");
+                randCount = 0;
+            } else {
+                for (unsigned i = 0; i < randCount; i++) {
+                    char envNameBuffer[64];
+                    snprintf(envNameBuffer, sizeof(envNameBuffer), "PSAN_ENV_RAND_%d", i);
+                    char* PSAN_ENV_RAND = getenv(envNameBuffer);
+                    if (PSAN_ENV_RAND) {
+                        if (PSAN_ENV_RAND[0] == '-') {
+                            int64_t tmpval = 0;
+                            sscanf(PSAN_ENV_RAND, "%" PRId64, &tmpval);
+                            PSAN_RAND_POOL[i] = (uint64_t)tmpval;
+                        } else {
+                            sscanf(PSAN_ENV_RAND, "%" PRIu64, &PSAN_RAND_POOL[i]);
+                        }
+                    } else {
+                        printf("PSAN_ENV_RAND_%d not set\n", i);
+                    }
+                }
+            }
+        } else {
+            printf("PSAN_ENV_RAND_COUNT not set\n");
+        }
+        initialized = 1;
+    }
+    if (consumed < randCount) {
+        *v = PSAN_RAND_POOL[consumed];
+        consumed++;
+        return 1;
+    }
+}
