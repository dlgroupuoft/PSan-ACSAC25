diff --git a/olden/Makefile b/olden/Makefile
index 0b0ce6b..bdad172 100644
--- a/olden/Makefile
+++ b/olden/Makefile
@@ -1,14 +1,19 @@
-CFLAGS ?= -O2 -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast -Wno-parentheses-equality -Wno-implicit-int-float-conversion
+CFLAGS ?= -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast -Wno-parentheses-equality -Wno-implicit-int-float-conversion -O1 $(COMMON_CFLAGS)
+CC ?= gclang
 
 bench = bh bisort em3d health mst perimeter power treeadd tsp voronoi
 bins = $(addsuffix .exe, $(bench))
+bcs = $(addsuffix .bc, $(bench))
 
-all: $(bins)
+all: $(bcs)
 
 .PHONY: clean
 
 %.exe: %/src/*.c
 	$(CC) $(CFLAGS) -DTORONTO -I. -I$(basename $@)/src $^ -lm -o $@
 
+%.bc: %.exe
+	get-bc -o $@ $<
+
 clean:
-	rm -f $(bins)
+	rm -f $(bins) $(bcs)
